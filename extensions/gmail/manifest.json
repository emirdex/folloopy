{
  "manifest_version": 3,
  "name": "Folloopy — Gmail Takibi",
  "version": "1.1.0",
  "description": "Gmail takip paneli, şablonlar ve takipli gönderim. Free günlük 3 mail; Essential ve Signature ile gelişmiş araçlar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://panel.folloopy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Folloopy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "tools.js",
        "gmail.js"
      ],
      "css": [
        "gmail.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://folloopy.com/"
}
