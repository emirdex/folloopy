# Full application deployment; without this opt-in only the public website runs.
APP_MODE=application
NODE_ENV=production
SITE_URL=https://folloopy.com
NEXT_PUBLIC_SITE_URL=https://folloopy.com
# Set these only after the panel deployment has working DNS and HTTPS.
# On folloopy.com use DEPLOYMENT_ROLE=public and RUN_BACKGROUND_WORKERS=false.
# On panel.folloopy.com use DEPLOYMENT_ROLE=panel and RUN_BACKGROUND_WORKERS=true.
# Both deployments share the existing database and encryption keys.
# APP_URL=https://panel.folloopy.com
# NEXT_PUBLIC_APP_URL=https://panel.folloopy.com
# PUBLIC_TRACKING_ORIGIN=https://folloopy.com
DEPLOYMENT_ROLE=combined
RUN_BACKGROUND_WORKERS=true
# Hostinger assigns PORT. Do not override it in hPanel unless requested.
API_PORT=4000
INTERNAL_API_URL=http://127.0.0.1:4000
# External PostgreSQL direct/session-pool connection, TLS with valid certificates.
# Never disable certificate verification. Provider-specific SSL parameters go in this URL.
DATABASE_URL=
# Independently generate each value. Never commit real values.
INTERNAL_API_KEY=
DATA_ENCRYPTION_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
ADMIN_OWNER_EMAIL=emir@dexdijital.com
# One-time bootstrap; remove from hosting after owner activation. Empty disables new setup.
ADMIN_SETUP_TOKEN=
# Required for the public contact form in either APP_MODE, and for account emails.
# Verify folloopy.com in Resend first; the inbox info@folloopy.com must also exist.
RESEND_API_KEY=
MAIL_FROM=Folloopy <info@folloopy.com>
# No charging until a payment provider is implemented.
# disabled: no package activation; complimentary: grant access without charging.
# Temporary application launch without a payment provider: no charge is made.
BILLING_MODE=complimentary
# Optional until enabled in Google Cloud. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Preserve the three existing public articles on the first application launch.
# Set false after the first successful database initialization.
SEED_BLOG=true
# Preparatory integrations. Leave disabled until provider onboarding and end-to-end validation.
PAYMENT_PROVIDER=
PAYMENT_CONFIGURATION_VERIFIED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OUTLOOK_CONFIGURATION_VERIFIED=false
