# Full application deployment; without this opt-in only the public website runs.
APP_MODE=application
NODE_ENV=production
SITE_URL=https://folloopy.com
NEXT_PUBLIC_SITE_URL=https://folloopy.com
# Hostinger assigns PORT. Do not override it in hPanel unless requested.
API_PORT=4000
INTERNAL_API_URL=http://127.0.0.1:4000
# External PostgreSQL direct/session-pool connection, TLS with valid certificates.
# Never disable certificate verification. Provider-specific SSL parameters go in this URL.
DATABASE_URL=
# Independently generate each value. Never commit real values.
INTERNAL_API_KEY=
DATA_ENCRYPTION_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
ADMIN_OWNER_EMAIL=emir@dexdijital.com
# One-time bootstrap; remove from hosting after owner activation. Empty disables new setup.
ADMIN_SETUP_TOKEN=
# Required for verification and password reset. Verify folloopy.com in Resend first.
RESEND_API_KEY=
MAIL_FROM=Folloopy <info@folloopy.com>
# No charging until a payment provider is implemented.
# disabled: no package activation; complimentary: grant access without charging.
BILLING_MODE=disabled
# Optional until enabled in Google Cloud. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seed editorial articles only when explicitly desired.
SEED_BLOG=false
