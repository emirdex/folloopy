# Gerçek sır koymayın. Yerel dev komutu geçici anahtarı kendisi üretir.
APP_NAME=Folloopy
PUBLIC_TRACKING_ORIGIN=http://127.0.0.1:4000
# PostgreSQL kullanmak için; boşsa geliştirmede gömülü PostgreSQL çalışır.
DATABASE_URL=
# Harici API başlatırken en az 32 karakter; dev başlatıcı otomatik üretir.
DEV_API_KEY=
# Henüz bağlı olmayan entegrasyonlar:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Outlook hazırlığı. Gizli değerler yalnızca sunucu ortamında saklanır.
# Aşağıdaki callback henüz yayınlanmış bir bağlantı akışı değildir.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET_EXPIRES_AT=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://panel.folloopy.com/api/oauth/microsoft/callback
OUTLOOK_CONFIGURATION_VERIFIED=false

# İlk yerel yönetici kurulumu için; kurulumdan sonra DB kaydı esas alınır.
ADMIN_OWNER_EMAIL=emir@dexdijital.com
