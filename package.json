{
  "name": "mail-tracking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/build-file-viewer.mjs && node --import tsx scripts/dev.ts",
    "dev:api": "node --import tsx apps/api/main.ts",
    "dev:web": "next dev apps/web --port 3000",
    "worker": "node --import tsx apps/worker/main.ts",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build/prepare-deployment.mjs && node scripts/build-file-viewer.mjs && node scripts/build-extension.mjs && next build apps/web --webpack && node scripts/build/clean-cache.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "start": "node server.cjs",
    "preflight": "node --import tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@next/swc-wasm-nodejs": "16.4.2",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "2.16.2",
    "typescript": "7.0.2"
  }
}
